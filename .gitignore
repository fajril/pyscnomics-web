# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
.DS_Store
dist
dist-ssr
*.local
/cypress/videos/
/cypress/screenshots/
.gitignore

# 👉 Custom Git ignores
~tmp
release
release2
pyscnomics-env
python-3.12.4*
*.7z
backup
warn-main.txt

# Editor directories and files
