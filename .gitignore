!.vscode/settings.json
!.vscode/*.code-snippets
!.vscode/tours
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.yarn

# iconify dist files
src/plugins/iconify/icons.css

# Ignore MSW script
public/mockServiceWorker.js

